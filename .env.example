# Local development database. Production should use the Supabase Postgres
# pooler URL after switching to the PostgreSQL Prisma schema.
DATABASE_URL="file:./dev.db"
SUPABASE_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=5"
SUPABASE_DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Supabase private storage (server-only secret; never prefix the secret with NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Server-only alias accepted when NEXT_PUBLIC_SUPABASE_URL is not set.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_CV_BUCKET="candidate-resumes"
# Backward-compatible alias for SUPABASE_CV_BUCKET.
SUPABASE_STORAGE_BUCKET="candidate-resumes"
SUPABASE_ASSESSMENT_BUCKET="assessment-recordings"

# CV queue. Vercel Cron automatically sends CRON_SECRET as a bearer token.
CRON_SECRET=""
CV_WORKER_SECRET=""

# AI providers (optional). Use a dedicated encryption key for stored provider keys.
AI_PROVIDER="gemini"
AI_SETTINGS_ENCRYPTION_KEY=""
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
