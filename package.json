{
  "name": "recruitment-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:supabase": "prisma generate --schema prisma/schema.postgresql.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:cv": "tsx scripts/cv-worker.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:push:supabase": "prisma db push --schema prisma/schema.postgresql.prisma",
    "db:seed:supabase": "prisma generate --schema prisma/schema.postgresql.prisma && tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "2.112.3",
    "bcryptjs": "2.4.3",
    "mammoth": "^1.12.1",
    "next": "15.5.23",
    "pdf-parse": "^2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.19.33",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.5.26",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.6",
    "tsx": "4.23.12",
    "typescript": "5.5.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.0"
  }
}
